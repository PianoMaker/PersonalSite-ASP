@page
@model PersonalSite.Pages.uk.WebModel

@{
    ViewData["Title"] = "Веб-проєкти";
}

<div class="bio-page coffebackground">

    <div class="web-layout">

        <div class="web-content">

            <div class="page-intro webintro">
                <h1>Мої Веб-проєкти</h1>
            </div>

            <div class="music web-section">
                <!-- ОСНОВНИЙ ТЕКСТ -->
                <div class="web-grid">

                    <div class="web-item">
                        <a href="https://musicinukrainian.wordpress.com/">
                            <div class="web-item-content">
                                <p>Світова музична класика українською</p>
                                <small>Вокальні твори в українських перекладах - арії, романси, інформації про вокальні конкурси</small>
                            </div>

                            <img src="~/images/WCU.png" alt="Світова музична класика українською">
                        </a>
                    </div>

                    <div class="web-item">
                        <a href="https://www.melody.pp.ua">
                            <div class="web-item-content">
                                <p>Мелодія</p>
                                <small>Пошук мелодій по нотах. В базі даних - понад 500 мелодій, які можна знайти за введеними нотами з фортепіанної клавіатури</small>
                            </div>

                            <img src="~/images/melody.png" alt="Мелодія">
                        </a>
                    </div>

                    <div class="web-item">
                        <a href="https://solfegio.azurewebsites.net/">
                            <div class="web-item-content">
                                <p>Сольфеджіо</p>
                                <small>Тренувальник інтервалів та акордів на слух. Для студентів і всіх кому потрібно вміти розрізняти співзвуччя на слух </small>
                            </div>

                            <img src="~/images/solfegio.png" alt="Сольфеджіо">
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
