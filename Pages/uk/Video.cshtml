@page
@model VideoModel
@{
    ViewData["Title"] = "Відео";
}

<div class="bio-page coffebackground">

    <div class="page-layout">

        <div class="page-content">

            <div class="page-intro">
                <h1>Мої відео на YouTube</h1>
            </div>

            <div class="music page-section">
                <!-- ОСНОВНИЙ ТЕКСТ -->


                <div class="page-intro">
                    <h1>Відео</h1>
                </div>

                <div class="music page-section">
                    <section class="subsetion" id="music">

                        <h2>Музичні</h2>

                        <ul class="publications-list">

                            @foreach (var work in Model.Music)
                            {
                                <li>

                                    @if (work.Links.Any())
                                    {
                                        <a href="@work.Links.First().Url" target="_blank">
                                            <strong>
                                                @Html.Raw(work.UkTitle)
                                            </strong>
                                        </a>
                                    }
                                    else
                                    {
                                        <strong>
                                            @Html.Raw(work.UkTitle)
                                        </strong>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(work.UkMeta))
                                    {
                                        <span>
                                            @Html.Raw(work.UkMeta)
                                        </span>
                                    }

                                </li>
                            }

                        </ul>

                    </section>

                </div>
                <div class="music page-section">
                    <section class="subsetion" id="tutorial">

                        <h2>Навчальні</h2>

                        <ul class="publications-list">

                            @foreach (var work in Model.Tutorial)
                            {
                                <li>

                                    @if (work.Links.Any())
                                    {
                                        <a href="@work.Links.First().Url" target="_blank">
                                            <strong>
                                                @Html.Raw(work.UkTitle)
                                            </strong>
                                        </a>
                                    }
                                    else
                                    {
                                        <strong>
                                            @Html.Raw(work.UkTitle)
                                        </strong>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(work.UkMeta))
                                    {
                                        <span>
                                            @Html.Raw(work.UkMeta)
                                        </span>
                                    }

                                </li>
                            }

                        </ul>

                    </section>

                </div>
                <div class="music page-section">
                    <section class="subsetion" id="other">

                        <h2>Інше</h2>

                        <ul class="publications-list">

                            @foreach (var work in Model.Other)
                            {
                                <li>

                                    @if (work.Links.Any())
                                    {
                                        <a href="@work.Links.First().Url" target="_blank">
                                            <strong>
                                                @Html.Raw(work.UkTitle)
                                            </strong>
                                        </a>
                                    }
                                    else
                                    {
                                        <strong>
                                            @Html.Raw(work.UkTitle)
                                        </strong>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(work.UkMeta))
                                    {
                                        <span>
                                            @Html.Raw(work.UkMeta)
                                        </span>
                                    }

                                </li>
                            }

                        </ul>

                    </section>

                </div>
            </div>
        </div>
        <!-- НАВІГАЦІЯ -->
        <aside class="genre-gallery" id="genres-nav">
            <div class="bio-gallery-inner">
                <ul class="works-navigation">
                    <li><a href="#">[на початок]</a></li>
                    <li><a href="#music">Музичні</a></li>
                    <li><a href="#tutorial">Навчальні</a></li>
                    <li><a href="#other">Інше</a></li>

                </ul>
            </div>
        </aside>

    </div>
</div>
