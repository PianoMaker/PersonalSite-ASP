@page
@model MusicModel

@{
    ViewData["Title"] = "Музичні твори";
}

<div class="bio-page coffebackground">

    <div class="page-layout">

        <!-- ОСНОВНИЙ ТЕКСТ -->
        <div class="page-content">

            <div class="page-intro">
                <h1>Музичні твори</h1>
            </div>


            <!-- СЦЕНІЧНІ ТВОРИ -->
            <section class="home-section" id="scene">
                <div class="page-section">
                    <h3>Сценічні твори</h3>

                    <div class="works-list">

                        @foreach (var work in Model.MusicalWorks.Where(x => x.Section == "scene"))
                        {
                            <div class="work">

                                <span class="work-title">
                                    @Html.Raw(work.UkTitle)
                                </span>

                                @if (!string.IsNullOrWhiteSpace(work.UkMeta))
                                {
                                    <div class="work-meta">
                                        @Html.Raw(work.UkMeta)
                                    </div>
                                }

                                @if (work.Links.Any())
                                {
                                    <div class="work-links">

                                        @foreach (var link in work.Links)
                                        {
                                            <a class="resource @link.Type"
                                               href="@link.Url"
                                               target="_blank">
                                                @link.UkText
                                            </a>
                                        }

                                    </div>
                                }

                            </div>
                        }

                    </div>
                </div>
            </section>


