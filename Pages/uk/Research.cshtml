@page
@model ResearchModel
@{
    ViewData["Title"] = "Публікації";
}

<div class="bio-page coffebackground">

    <div class="page-layout">

        <!-- ОСНОВНИЙ ТЕКСТ -->
        <div class="page-content">

            <div class="page-intro">
                <h1>Дослідження</h1>
            </div>

            <div class="music page-section">

                <!-- МУЗИКА І МУЗИКОЗНАВСТВО -->
                <section class="subsetion">

                    @*    <h2>Музикознавство</h2> *@


                    <!-- Навчальний посібник -->
                    <h2>Навчальний посібник</h2>

                    <ul class="publications-list">

                        <li>
                            <a href="https://andrijbondarenko.wordpress.com/wp-content/uploads/2022/04/d091d0bed0bdd0b4d0b0d180d0b5d0bdd0bad0be_print_2022.pdf"
                               target="_blank">
                                <strong>
                                    Сучасне музичне мистецтво і комп’ютерні технології
                                </strong>
                            </a>
                            <span>
                                Київ, 2022.
                            </span>
                        </li>

                    </ul>
                </section>

                <!-- НАУКОВІ СТАТТІ -->
                <section class="subsetion" id="articles">

                    <h2>Наукові статті</h2>

                    <ul class="publications-list">

                        @foreach (var work in Model.Works
                                                .Where(w => w.Subsection == "articles"))
                        {
                            <li>

                                @if (work.Links.Any())
                                {
                                    <a href="@work.Links.First().Url" target="_blank">
                                        <strong>
                                            @Html.Raw(work.UkTitle)
                                        </strong>
                                    </a>
                                }
                                else
                                {
                                    <strong>
                                        @Html.Raw(work.UkTitle)
                                    </strong>
                                }

                                @if (!string.IsNullOrWhiteSpace(work.UkMeta))
                                {
                                    <span>
                                        @Html.Raw(work.UkMeta)
                                    </span>
                                }

                            </li>
                        }

                    </ul>

                </section>

                <!-- АНГЛІЙСЬКОЮ -->
                <section class="subsetion" id="english">

                    <h2>Англійською</h2>

                    <ul class="publications-list">

                        @foreach (var work in Model.Works
                                                .Where(w => w.Subsection == "articles-en"))
                        {
                            <li>

                                @if (work.Links.Any())
                                {
                                    <a href="@work.Links.First().Url" target="_blank">
                                        <strong>
                                            @Html.Raw(work.EnTitle)
                                        </strong>
                                    </a>
                                }
                                else
                                {
                                    <strong>
                                        @Html.Raw(work.EnTitle)
                                    </strong>
                                }

                                @if (!string.IsNullOrWhiteSpace(work.EnMeta))
                                {
                                    <span>
                                        @Html.Raw(work.EnMeta)
                                    </span>
                                }

                            </li>
                        }

                    </ul>

                </section>


                <!-- ТЕЗИ ДОПОВІДЕЙ -->
                <section class="subsetion" id="thesis">

                    <h2>Тези доповідей</h2>

                    <ul class="publications-list">

                        @foreach (var work in Model.Works
                                                .Where(w => w.Subsection == "theses"))
                        {
                            <li>

                                @if (work.Links.Any())
                                {
                                    <a href="@work.Links.First().Url" target="_blank">
                                        <strong>
                                            @Html.Raw(work.UkTitle)
                                        </strong>
                                    </a>
                                }
                                else
                                {
                                    <strong>
                                        @Html.Raw(work.UkTitle)
                                    </strong>
                                }

                                @if (!string.IsNullOrWhiteSpace(work.UkMeta))
                                {
                                    <span>
                                        @Html.Raw(work.UkMeta)
                                    </span>
                                }

                            </li>
                        }

                    </ul>

                </section>
                <!-- ПУБЛІКАЦІЇ -->
                <section class="subsetion" id="periodicals">

                    <h2>Тези доповідей</h2>

                    <ul class="publications-list">

                        @foreach (var work in Model.Works
                                                .Where(w => w.Subsection == "periodicals"))
                        {
                            <li>

                                @if (work.Links.Any())
                                {
                                    <a href="@work.Links.First().Url" target="_blank">
                                        <strong>
                                            @Html.Raw(work.UkTitle)
                                        </strong>
                                    </a>
                                }
                                else
                                {
                                    <strong>
                                        @Html.Raw(work.UkTitle)
                                    </strong>
                                }

                                @if (!string.IsNullOrWhiteSpace(work.UkMeta))
                                {
                                    <span>
                                        @Html.Raw(work.UkMeta)
                                    </span>
                                }

                            </li>
                        }

                    </ul>

                </section>


            </div>
        </div>
        <!-- НАВІГАЦІЯ -->
        <aside class="genre-gallery" id="genres-nav">
            <div class="bio-gallery-inner">
                <ul class="works-navigation">
                    <li><a href="#">[на початок]</a></li>
                    <li><a href="#2006">Статті 2006-2020</a></li>
                    <li><a href="#2020">Статті 2020- </a></li>
                    <li><a href="#english">Англійською</a></li>
                    <li><a href="#thesis">Тези доповідей</a></li>
                    <li><a href="#other">В періодичних виданнях</a></li>
                    <li><a href="#choir">Про Вікіпедію</a></li>
                </ul>
            </div>
        </aside>

    </div>
</div>
