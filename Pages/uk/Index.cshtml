@page
@model IndexModel
@{
    ViewData["Title"] = "Андрій Бондаренко";
}

<div class="hero home-hero">
    <div class="hero-inner">
        <div class="hero-content">
            <h1>Андрій Бондаренко</h1>

            <p class="hero-role">
                Піаніст · Композитор · Дослідник
            </p>

            <p class="hero-intro">
                Ласкаво просимо на сайт Андрія Бондаренка — піаніста,
                композитора та дослідника сучасної музичної культури.
                Тут представлені концертні записи, композиції і дослідження.
            </p>
        </div>
    </div>
</div>


<section class="home-section odd">
    <div class="hero-inner">

        <div class="hero-text">
            <h1>Біографія</h1>

            <p>
                Андрій Бондаренко — піаніст, композитор, викладач та дослідник музики.
            </p>

            <p>
                Закінчив Національну музичну академію України за фахом
                фортепіано та композиція. Лауреат міжнародних конкурсів.
            </p>

            <p>
                З 2001 року викладає в Київському національному університеті
                культури і мистецтв.
            </p>

            <p>
                Засновник проекту «Світова класика українською» та один із
                засновників «Вікімедіа Україна».
            </p>

            <a href="/uk/about" class="details-button">Детальніше</a>
        </div>

        <div class="hero-image">
            <img src="~/images/academic.png"
                 alt="Андрій Бондаренко" />
        </div>

    </div>
</section>


<section class="home-section" id="music">
    <div class="home-inner">
        <h2>Музичні твори</h2>
        <h3>Вибрані твори</h3>

        <div class="works-list">
            <div>
                <span>Вокальний цикл на вірші Ліни Костенко</span>
                <b>1992</b>
            </div>

            <div>
                <span>Концерт для фортепіано з оркестром</span>
                <b>2002</b>
            </div>

            <div>
                <span>Райок по-українськи</span>
                <small>для солістів, хору і інструментального супроводу</small>
                <b>2004–2006</b>
            </div>

            <div>
                <span>Симфонічна поема «2004»</span>
                <b>2006</b>
            </div>

            <div>
                <span>Гімн Вікіпедії</span>
                <small>для читця, вокального та інструментального ансамблів</small>
                <b>2016</b>
            </div>

            <div>
                <span>Різдвяна пісня</span>
                <small>мюзикл за мотивами казки Ч. Діккенса, лібрето Олени О'Лір</small>
                <b>2018</b>
            </div>

            <div>
                <span>10 українських народних пісень</span>
                <small>для фортепіано</small>
                <b>2019–2020</b>
            </div>
        </div>

        <a href="/uk/music" class="details-button">Детальніше</a>
    </div>
</section>


<section class="home-section odd" id="video">
    <div class="home-inner">
        <h2>Відео</h2>

        <div class="video-links">
            <span>Живі виступи</span>
            <span>Освітні відео</span>
        </div>

        <a href="/uk/video" class="details-button">Детальніше</a>
    </div>
</section>


<section class="home-section" id="research">
    <div class="home-inner">
        <h2>Дослідження</h2>
        <h3>Останні дослідження</h3>

        <div class="research-list">

            <div>
                <h4>Електронна музика в Україні</h4>
                <em>дисертація кандидата музикознавства</em>
                <b>2021</b>
            </div>

            <div>
                <h4>Сучасне музичне мистецтво і комп'ютерні технології</h4>
                <em>Навчальний посібник</em>
                <b>2022</b>
            </div>

            <div>
                <h4>Системи штучного інтелекту в музичній освіті: досвід використання</h4>
                <em>Bulletin of Kyiv National University of Culture and Arts. Series in Musical Art</em>
                <b>2026</b>
            </div>

        </div>

        <a href="/uk/research" class="details-button">Детальніше</a>
    </div>
</section>


