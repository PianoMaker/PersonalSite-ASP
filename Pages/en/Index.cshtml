@page
@model IndexModel
@{
    ViewData["Title"] = "Andrii Bondarenko";
}

<div class="hero home-hero">
    <div class="hero-inner">
        <div class="hero-content">
            <h1>Andrii Bondarenko</h1>

            <p class="hero-role">
                Pianist · Composer · Researcher
            </p>

            <p class="hero-intro">
                Welcome to the website of Andrii Bondarenko — pianist,
                composer and researcher of contemporary musical culture.
                Here you can find concert recordings, compositions and research.
            </p>
        </div>
    </div>
</div>


<section class="home-section odd">
    <div class="hero-inner">

        <div class="hero-text">
            <h1>Biography</h1>

            <p>
                Andrii Bondarenko is a pianist, composer, educator and music researcher.
            </p>

            <p>
                He graduated from the National Music Academy of Ukraine with degrees in
                piano and composition. Laureate of international competitions.
            </p>

            <p>
                Since 2001, he has taught at the Kyiv National University
                of Culture and Arts.
            </p>

            <p>
                Founder of the “World Classics in Ukrainian” project and one of
                the founders of Wikimedia Ukraine.
            </p>

            <a href="/en/about" class="details-button">Learn More</a>
        </div>

        <div class="hero-image">
            <img src="~/images/academic.png"
                 alt="Andrii Bondarenko" />
        </div>

    </div>
</section>


<section class="home-section" id="music">
    <div class="home-inner">
        <h2>Musical Works</h2>
        <h3>Selected Works</h3>

        <div class="works-list">
            <div>
                <span>Vocal Cycle on Poems by Lina Kostenko</span>
                <b>1992</b>
            </div>

            <div>
                <span>Piano Concerto with Orchestra</span>
                <b>2002</b>
            </div>

            <div>
                <span>Rayok in Ukrainian</span>
                <small>for soloists, choir and instrumental accompaniment</small>
                <b>2004–2006</b>
            </div>

            <div>
                <span>Symphonic Poem «2004»</span>
                <b>2006</b>
            </div>

            <div>
                <span>Anthem to Wikipedia</span>
                <small>for narrator, vocal and instrumental ensembles</small>
                <b>2016</b>
            </div>

            <div>
                <span>A Christmas Carol</span>
                <small>musical based on the novella by Charles Dickens, libretto by Olena O'Lear</small>
                <b>2018</b>
            </div>

            <div>
                <span>10 Ukrainian Folk Songs</span>
                <small>for piano</small>
                <b>2019–2020</b>
            </div>
        </div>

        <a href="/en/music" class="details-button">Learn More</a>
    </div>
</section>


<section class="home-section odd" id="video">
    <div class="home-inner">
        <h2>Video</h2>

