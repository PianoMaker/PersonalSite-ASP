@page
@model PersonalSite.Pages.en.WebModel

@{
    ViewData["Title"] = "Web Projects";
}

<div class="bio-page coffebackground">

    <div class="web-layout">

        <div class="web-content">

            <div class="page-intro webintro">
                <h1>My Web Projects</h1>
            </div>

            <div class="music web-section">
                <!-- MAIN CONTENT -->
                <div class="web-grid">

                    <div class="web-item">
                        <a href="https://musicinukrainian.wordpress.com/">
                            <div class="web-item-content">
                                <p>World Classical Music in Ukrainian</p>
                                <small>Vocal works in Ukrainian translations — arias, romances, and information about vocal competitions</small>
                            </div>

                            <img src="~/images/WCU.png" alt="World Classical Music in Ukrainian">
                        </a>
                    </div>

                    <div class="web-item">
                        <a href="https://www.melody.pp.ua">
                            <div class="web-item-content">
                                <p>Melody</p>
                                <small>Melody search by notes. The database contains more than 500 melodies that can be found by entering notes using a piano keyboard</small>
                            </div>

                            <img src="~/images/melody.png" alt="Melody">
                        </a>
                    </div>

                    <div class="web-item">
                        <a href="https://solfegio.azurewebsites.net/">
                            <div class="web-item-content">
                                <p>Solfeggio</p>
                                <small>An ear-training tool for identifying intervals and chords. Designed for students and anyone who needs to learn to distinguish musical sounds by ear</small>
                            </div>

                            <img src="~/images/solfegio.png" alt="Solfeggio">
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>