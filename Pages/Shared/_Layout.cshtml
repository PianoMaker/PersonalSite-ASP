<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta property="og:title" content="@ViewData["Title"] - Андрій Бондаренко" />
    <meta property="og:description" content="Персональний сайт Андрія Бондаренка — композитора, піаніста та дослідника музики." />
    <meta property="og:image" content="https://andriibondarenko.pp.ua/images/og-image.png" />
    <meta property="og:url" content="https://andriibondarenko.pp.ua@Context.Request.Path" />
    <meta property="og:type" content="website" />

    <link rel="canonical" href="https://andriibondarenko.pp.ua@Context.Request.Path" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://andriibondarenko.pp.ua/images/og-image.png" />
    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "Person",
          "name": "Andrii Bondarenko",
          "url": "https://andriibondarenko.pp.ua/",
          "jobTitle": "Pianist, Composer, Researcher",
          "sameAs": [
            "https://github.com/PianoMaker",
            "https://www.youtube.com/channel/UCU0uoVAp9po6P8mRpRkNhBQ",
            "https://soundcloud.com/nf0mocjilsnz",
            "https://knukim.academia.edu/АндрійБондаренко",
            "https://www.researchgate.net/profile/Andriy-Bondarenko-4",
            "https://orcid.org/0000-0002-6856-991X",
            "https://www.wikidata.org/wiki/Q4093179",
            "https://en.wikipedia.org/wiki/Andriy_Bondarenko",
            "https://soundbetter.com/profiles/610791-andrii-bondarenko"
            "https://andriibondarenko.bandcamp.com/"
          ]
        }
    </script>

    <title>@ViewData["Title"] - Андрій Бондаренко</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/bio.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PersonalSite.styles.css" asp-append-version="true" />


</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-coffee border-bottom box-shadow">
            <div class="container">

               @*  <a class="navbar-brand" href="@(Context.Request.Path.StartsWithSegments("/en") ? "/en" : "/uk")">
                    @(Context.Request.Path.StartsWithSegments("/en") ? "Andrii Bondarenko" : "Андрій Бондаренко")
                </a> *@

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Menu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">

                        @if (Context.Request.Path.StartsWithSegments("/en"))
                        {
                            <!-- ENGLISH MENU -->

                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/en">Home</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/en/Bio">Biography</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/en/Music">Musical Works</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/en/Video">Video</a>
                            </li>

                            

                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/en/Research">Research</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/uk/Web">Web-projects</a>
                            </li>
@* 
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/en/Publications">Publications About Me</a>
                            </li> *@

                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/en#contact">Contact</a>
                            </li>
                        }
                        else
                        {
                            <!-- UKRAINIAN MENU -->

                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/uk">Головна</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/uk/Bio">Біографія</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/uk/Music">Музичні твори</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/uk/Video">Відео</a>
                            </li>

                           <li class="nav-item">
                                <a class="nav-link text-dark" href="/uk/Research">Дослідження</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/uk/Web">Веб-проєкти</a>
                            </li>

@*                             <li class="nav-item">
                                <a class="nav-link text-dark" href="/uk/Publications">Публікації про мене</a>
                            </li> *@

                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/uk#contact">Контакти</a>
                            </li>
                        }

                    </ul>

                    <!-- LANGUAGE SWITCHER -->
                    <div class="language-switcher">

                        @{
                            var currentPath = Context.Request.Path.Value ?? "/";
                            var ukPath = currentPath.StartsWith("/en")
                            ? "/uk" + currentPath.Substring(3)
                            : currentPath;
                            var enPath = currentPath.StartsWith("/uk")
                            ? "/en" + currentPath.Substring(3)
                            : currentPath;
                        }

                        @if (Context.Request.Path.StartsWithSegments("/en"))
                        {
                            <a href="@ukPath" class="text-dark">UK</a>
                            <span class="text-muted">|</span>
                            <a href="@enPath" class="text-accent">EN</a>
                        }
                        else
                        {
                            <a href="@ukPath" class="text-accent">UK</a>
                            <span class="text-muted">|</span>
                            <a href="@enPath" class="text-dark">EN</a>
                        }
                    </div>

                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Андрій Бондаренко
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>