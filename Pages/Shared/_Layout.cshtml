<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Андрій Бондаренко</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/bio.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PersonalSite.styles.css" asp-append-version="true" />

    <style>
        body {
            background-image: url('/images/background.png');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            background-repeat: no-repeat;
        }
    </style>
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">

                <a class="navbar-brand" href="@(Context.Request.Path.StartsWithSegments("/en") ? "/en" : "/uk")">
                    @(Context.Request.Path.StartsWithSegments("/en") ? "Andrii Bondarenko" : "Андрій Бондаренко")
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Menu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">

                        @if (Context.Request.Path.StartsWithSegments("/en"))
                        {
                            <!-- ENGLISH MENU -->

                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/en">Home</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/en/Works">Musical Works</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/en/Video">Video</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/en/Bio">Biography</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/en/Research">Research</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/en/Publications">Publications About Me</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/en#contact">Contact</a>
                            </li>
                        }
                        else
                        {
                            <!-- UKRAINIAN MENU -->

                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/uk">Головна</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/uk/Works">Музичні твори</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/uk/Video">Відео</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/uk/Bio">Біографія</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/uk/Research">Дослідження</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/uk/Publications">Публікації про мене</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/uk#contact">Контакти</a>
                            </li>
                        }

                    </ul>

                    <!-- LANGUAGE SWITCHER -->

                    <div class="language-switcher">
                        @if (Context.Request.Path.StartsWithSegments("/en"))
                        {
                            <a href="/uk" class="text-dark">UK</a>
                            <span class="text-muted">|</span>
                            <a href="/en" class="text-accent">EN</a>
                        }
                        else
                        {
                            <a href="/uk" class="text-accent">UK</a>
                            <span class="text-muted">|</span>
                            <a href="/en" class="text-dark">EN</a>
                        }
                    </div>

                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Андрій Бондаренко
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>